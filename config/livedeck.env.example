# ============================================================
# 多屏直播台（livedeck）登录态 —— 只有用直播台才需要
# ------------------------------------------------------------
# 不要手写这个文件：直接跑
#   python run_livedeck.py
# 弹出页面后点「扫码登录」，成功后由程序自动写入（含 bili_jct，权限 600）。
#
# 与 config/bili.env 相互独立：monitor 只需要 SESSDATA，
# 直播台还需要 bili_jct 才能取播放地址。
# ============================================================

SESSDATA=
BILI_JCT=
DEDEUSERID=
